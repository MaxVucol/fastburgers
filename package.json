{
  "name": "fastburgers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "node scripts/check-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings --import ./tests/setup/register.mjs --test --test-concurrency=1 \"tests/*.test.ts\"",
    "db": "node scripts/dev-db.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:check:atlas": "node scripts/atlas-check.mjs",
    "db:push:atlas": "node --env-file=.env.atlas node_modules/prisma/build/index.js db push --skip-generate",
    "db:seed:atlas": "node --env-file=.env.atlas node_modules/prisma/build/index.js db seed",
    "images:fetch": "node scripts/fetch-images.mjs",
    "og:build": "node scripts/make-og.mjs",
    "postinstall": "prisma generate",
    "check-env": "node scripts/check-env.mjs",
    "telegram:check": "node scripts/telegram-check.mjs",
    "mail:check": "tsx scripts/mail-check.mts",
    "admin:grant": "tsx scripts/make-admin.ts",
    "admin:grant:atlas": "node --env-file=.env.atlas node_modules/tsx/dist/cli.mjs scripts/make-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "mongodb-memory-server-core": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
