# MongoDB connection string. Prisma requires a replica set (Atlas works out of the box).
# Local dev: run `npm run db` and use the value below.
DATABASE_URL="mongodb://127.0.0.1:27017/fastburgers?replicaSet=rs0&directConnection=true"
# Secret used to sign admin session cookies (min. 32 chars). Generate: openssl rand -base64 32
AUTH_SECRET=""
# Public URL used for SEO (sitemap, Open Graph, canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Admin account created by `npm run db:seed`.
ADMIN_EMAIL="admin@fastburgers.ro"
ADMIN_PASSWORD="change-me"
