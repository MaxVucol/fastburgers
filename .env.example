# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project → Settings → Environment Variables
# (for both Production and Preview). `npm run build` checks them first.

# ── MongoDB (required, also at build time) ─────────────────────────────────────
# Prisma needs a replica set and the database name in the path.
# Local dev (`npm run db`):
DATABASE_URL="mongodb://127.0.0.1:27017/fastburgers?replicaSet=rs0&directConnection=true"
# Production / Vercel — MongoDB Atlas (URL-encode special characters in the password):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fastburgers?retryWrites=true&w=majority"

# ── Admin sessions (required) ───────────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET=""

# ── Image uploads from /admin (required on Vercel) ─────────────────────────────
# Created automatically when you connect a Vercel Blob store to the project.
# Leave empty locally: uploads are then stored in ./storage/uploads.
BLOB_READ_WRITE_TOKEN=""

# ── Public URL (recommended) ─────────────────────────────────────────────────────
# Used for canonical URLs, sitemap and Open Graph. On Vercel it falls back to the
# project's production domain when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed script only (`npm run db:seed` / `npm run db:seed:atlas`) — not needed on Vercel ──
# Required, no default password. For a remote database: 12+ chars, 3 of a-z/A-Z/0-9/symbols.
ADMIN_EMAIL="admin@fastburgers.ro"
ADMIN_PASSWORD=""
# Create the 7 fictional demo orders (default: true locally, false for a remote database).
# SEED_DEMO_ORDERS="false"
# The seed refuses to run on a database that already has catalog/orders.
# Set to "true" only to deliberately reset a LOCAL development database.
# SEED_ALLOW_RESET="false"

# Orders: "live" for the real restaurant. Anything else (default) tags every order as a demo order
# (shown as "demo" in the admin list), so demo traffic can be told apart and cleaned up.
# It is only a label: demo orders are still saved and still sent to Telegram / the owner's e-mail.
# A Vercel Preview ignores it (always demo) and is built only with DATABASE_URL naming the database
# "fastburgers_preview"; Telegram, e-mail and Blob writes are switched off there (lib/preview-guard.mjs).
ORDER_MODE="demo"

# Rate limiting (admin sign-in, orders) keeps its counters in the same MongoDB, so it works across
# all server instances with no extra service. The client IP is taken from Vercel's own headers on
# Vercel. Self-hosted behind your own reverse proxy: name the header it sets (e.g. x-real-ip);
# without it, per-IP limits are skipped and only per-account / per-phone limits apply.
# TRUSTED_IP_HEADER=""

# ── E-mail (account links, order e-mails) ─────────────────────────────────────
# Server-only: never prefix with NEXT_PUBLIC_. Without a provider the site says plainly that
# e-mail is unavailable (no fake "sent" message); orders and Telegram work either way.
# Check the setup (prints no secrets): npm run mail:check   ·   test send: npm run mail:check -- --send you@example.com
#
# Provider: "gmail" (Gmail SMTP, chosen for this site) or "resend".
EMAIL_PROVIDER="gmail"
# Sender name and address. With Gmail it must be GMAIL_USER (or a "Send mail as" alias of it).
# EMAIL_FROM="BUNIQ <your-address@gmail.com>"
#
# Gmail SMTP (smtp.gmail.com). GMAIL_APP_PASSWORD is a 16-letter APP password
# (Google Account → Security → 2-Step Verification → App passwords) — never the normal Google password.
# GMAIL_USER="your-address@gmail.com"
# GMAIL_APP_PASSWORD=""
# 465 = TLS (default), 587 = STARTTLS.
# GMAIL_SMTP_PORT="465"
#
# Resend (alternative): an API key, and EMAIL_FROM on a domain verified in Resend.
# RESEND_API_KEY=""
#
# Where the "new order" e-mail for the owner goes (optional).
# ADMIN_NOTIFY_EMAIL="owner@example.com"

# ── Sign in with Google (optional) ──────────────────────────────────────────────
# OAuth client of type "Web application" from Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: <site origin>/auth/google/callback (e.g. http://localhost:3000/auth/google/callback).
# Without both, the "Continue with Google" button is hidden.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional: a Telegram message to the owner for every new order (Bot API sendMessage).
# TELEGRAM_BOT_TOKEN: from @BotFather (/newbot). TELEGRAM_CHAT_ID: your personal chat id
# (send /start to the bot, then open https://api.telegram.org/bot<token>/getUpdates → message.chat.id).
# Server-only: never prefix them with NEXT_PUBLIC_. Without them no message is sent.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
